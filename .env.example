ACTIVAR_DOCS=<String>                           # Indicador para activar la documentación del API con los valores "false" o "true"
ALLOWED_HOSTS=<String>                          # Hosts permitidos (separados por comas), por ejemplo: "locahost, google.com"
API_RECAPTCHA_URL=<String>                      # URL del API de reCAPTCHA
CAPTCHA_SECRET=<String>                         # Clave privada de reCAPTCHA
CLIENTE_CAPTCHA=<String>                        # Clave pública de reCAPTCHA
CLIENTE_DRIVE_SCOPES=<String>                   # Scopes OAuth de Google Drive requeridos por la aplicación
CLIENTE_FIREBASE_API_KEY=<String>               # Clave de API de Firebase
CLIENTE_FIREBASE_APP_ID=<String>                # ID de la aplicación de Firebase
CLIENTE_FIREBASE_AUTH_DOMAIN=<String>           # Dominio de autenticación de Firebase
CLIENTE_FIREBASE_MEASUREMENT_ID=<String>        # ID de Google Analytics para Firebase
CLIENTE_FIREBASE_MESSAGING_SENDER_ID=<String>   # ID del remitente de mensajes de Firebase
CLIENTE_FIREBASE_PROJECT_ID=<String>            # ID del proyecto de Firebase
CLIENTE_FIREBASE_STORAGE_BUCKET=<String>        # Bucket de almacenamiento de Firebase
CORS_ORIGINS=<String>                           # URLs permitidas para CORS (separadas por comas), por ejemplo: "locahost, google.com"
FIREBASE_ADMIN_CREDS_PATH=<String>              # Ruta al archivo de las credenciales de adminsitrador de Firebase
ORIGENES_AUTORIZADOS=<string>                   # Origenes permitidos (separados por comas), por ejemplo: "locahost, google.com"